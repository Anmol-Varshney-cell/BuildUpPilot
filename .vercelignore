# Exclude Python venvs and caches
.venv/
.venv-1/
__pycache__/
*.pyc

# Exclude node_modules and heavy sub-apps (allow coding-portal/frontend/dist for static Skill Up frontend)
node_modules/
**/node_modules/
coding-portal/backend/
coding-portal/judge/
!coding-portal/frontend/dist/

# Exclude database files, logs, and IDE caches (allow buildup.db for cloud deployment)
!buildup.db
*.sqlite
instance/
logs/
.git/
.vscode/
.idea/
.claude/
.vercel/
