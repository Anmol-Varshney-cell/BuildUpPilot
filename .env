# BUILD UP PILOT Environment Configuration
# SSO & Authentication Configuration

# Database Configuration
# DATABASE_URL=sqlite:///buildup.db
REDIS_URL=redis://localhost:6379

# Flask & Security
SECRET_KEY=build-up-sso-secret-key-2024-change-in-production
FLASK_APP=app.py
PORT=5002

# SSO Configuration (OIDC)
SSO_SHARED_SECRET=build-up-secret-key-2024
OIDC_ISSUER=http://localhost:5002
OIDC_AUTH_ENDPOINT=http://localhost:5002/oauth/authorize
OIDC_TOKEN_ENDPOINT=http://localhost:5002/oauth/token
OIDC_USERINFO_ENDPOINT=http://localhost:5002/oauth/userinfo

# Coding Portal Backend Integration
SKILLUP_CLIENT_ID=coding-spirit-client
SKILLUP_CLIENT_SECRET=coding-spirit-secret
SKILLUP_REDIRECT_URI=http://localhost:5173

# SMS Gateway Configuration (optional - for real OTP delivery)
SMS_GATEWAY_URL=https://api.twilio.com/2010-04-01/Accounts
SMS_API_KEY=your_twilio_api_key_here
SMS_FROM_NUMBER=+1234567890

# Aadhaar KYC Provider Configuration (optional)
AADHAAR_API_BASE_URL=https://api.kycprovider.com
AADHAAR_API_KEY=your_aadhaar_api_key_here

# Application Configuration
DEMO_MODE=true

# Session Configuration
SESSION_TYPE=redis
SESSION_PERMANENT=false
SESSION_USE_SIGNER=true
PERMANENT_SESSION_LIFETIME=3600

# Development Settings
DEBUG=true
NODE_ENV=development
